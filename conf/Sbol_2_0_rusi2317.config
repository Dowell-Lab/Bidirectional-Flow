/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/methylseq -profile test
 */

/* A minimum usage example is as follows:
 *       nextflow run main.nf  -profile example
 * Enter ~/nextflow run main.nf -profile hg38 --help for more aguments
 */

params {
  // Sbol_2_0 Genome Reference Files
  genome = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/Sbol_2.0.chrom.fa"
  genome_refseq = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_transcripts.bed"
  filtered_refseq = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_diff53prime_with_putatives.gtf"
  filtered_refseq_bed = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_diff53prime_with_putatives.bed"
  trunc_refseq = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_diff53prime_with_putatives_5ptrunc.gtf"
  trunc_refseq_bed = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_diff53prime_with_putatives_5ptrunc.bed"
  mu_file = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/liftover_bidirs/Sbol_2.0_from_hg38_bidirs_MU.lifted.sorted.bed"
  bidir_accum = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/liftover_bidirs///Sbol_2.0_tfit_dreg_bidirectionals.saf"
  chrom_sizes = "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/Sbol_2.0.chrom.sizes"
  fstitch_path = "/scratch/Shares/dowell/FStitch/src/FStitch"
  fstitch_train = " "
  tfit_path = "/scratch/Shares/dowell/Tfit/src/Tfit"
  tfit_config = "/scratch/Shares/dowell/Tfit/config_files/config_file_K5.txt"
  tfit_config_k2 = "/scratch/Shares/dowell/Tfit/config_files/config_file_K2.txt"
  dreg_path = "/Users/rusi2317/bin/dREG/run_dREG.bsh"
  dreg_train = "/Users/rusi2317/bin/dREG/dREG_model/asvm.gdm.6.6M.20170828.rdata"
  promoter_bed= "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_promoters.bed"
  intron_bed= "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_introns.bed"
  intergenic_bed= "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_intergenic.bed"
  exon_bed= "/scratch/Shares/dowell/genomes/Sbol_2_0/chrom_renamed/refseq/Sbol_2.0_refseq_exons.bed"
}

