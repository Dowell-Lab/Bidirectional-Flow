/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/methylseq -profile test
 */

/* Will run data as paired-end by default. A minimum usage example is as follows:
 *       nextflow run main.nf  -profile fiji
 * Enter nextflow run main.nf -profile fiji --help for more aguments
 */

params {
  // Susie3 Genome Reference Files
  genome = "/Shares/txpnevol/genomes/Susie3/Susie3.main.fa"
  genome_refseq = "/scratch/Shares/dowell/genomes/"
  filtered_refseq = "/scratch/Shares/dowell/genomes/"
  filtered_refseq_bed = "/scratch/Shares/dowell/genomes/"
  trunc_refseq = "/scratch/Shares/dowell/genomes/"
  trunc_refseq_bed = "/scratch/Shares/dowell/genomes/"
  mu_file = "/scratch/Shares/dowell/genomes/"
  chrom_sizes = "/scratch/Shares/dowell/genomes/"
  promoter_bed= "/scratch/Shares/dowell/genomes/"
  intron_bed= "/scratch/Shares/dowell/genomes/"
  intergenic_bed= "/scratch/Shares/dowell/genomes/"
  exon_bed= "/scratch/Shares/dowell/genomes/"
  //mu_file = "/scratch/Users/rusi2317/projects/p53_interspecies/processed_data/lifted_tfit_combined/rheMac10_lifted_tfit_merged.bed"
  bidir_accum = "/scratch/Shares/dowell/genomes//liftover_bidirs///rheMac10_tfit_dreg_bidirectionals.saf"
  fstitch_path = "/scratch/Shares/dowell/FStitch/src/FStitch"
  fstitch_train = " "
  tfit_path = "/scratch/Shares/dowell/Tfit/src/Tfit"
  tfit_config = "/scratch/Shares/dowell/Tfit/config_files/config_file_K5.txt"
  tfit_config_k2 = "/scratch/Shares/dowell/Tfit/config_files/config_file_K2.txt"
  dreg_path = "/Users/rusi2317/bin/dREG/run_dREG.bsh"
  dreg_train = "/Users/rusi2317/bin/dREG/dREG_model/asvm.gdm.6.6M.20170828.rdata"
}
